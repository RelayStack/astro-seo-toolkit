{
  "name": "astro-seo-toolkit",
  "version": "0.5.0",
  "description": "Zero-dependency SEO toolkit for Astro & static sites: llms.txt, JSON-LD, IndexNow, sitemap.xml, robots.txt — plus a drop-in Astro integration and an installable agent skill.",
  "type": "module",
  "license": "MIT",
  "author": "RelayStack",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "astro-seo-toolkit": "./seo-toolkit/integration.mjs",
    "astro-seo-generate": "./seo-toolkit/integration.mjs",
    "astro-seo-check": "./seo-toolkit/check.mjs",
    "astro-seo-llms": "./seo-toolkit/llms-txt.mjs",
    "astro-seo-llms-full": "./seo-toolkit/llms-full.mjs",
    "astro-seo-sitemap": "./seo-toolkit/sitemap.mjs",
    "astro-seo-robots": "./seo-toolkit/robots.mjs",
    "astro-seo-indexnow": "./seo-toolkit/indexnow.mjs"
  },
  "keywords": [
    "seo",
    "astro",
    "astro-integration",
    "json-ld",
    "llms-txt",
    "indexnow",
    "sitemap",
    "robots-txt",
    "structured-data",
    "geo",
    "ai-search",
    "static-site"
  ],
  "homepage": "https://github.com/RelayStack/astro-seo-toolkit#readme",
  "bugs": {
    "url": "https://github.com/RelayStack/astro-seo-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RelayStack/astro-seo-toolkit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "astro": ">=4"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "files": [
    "seo-toolkit/",
    "skills/",
    "examples/",
    "notes/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./integration": "./seo-toolkit/integration.mjs",
    "./llms-txt": "./seo-toolkit/llms-txt.mjs",
    "./llms-full": "./seo-toolkit/llms-full.mjs",
    "./json-ld": "./seo-toolkit/json-ld.mjs",
    "./indexnow": "./seo-toolkit/indexnow.mjs",
    "./sitemap": "./seo-toolkit/sitemap.mjs",
    "./robots": "./seo-toolkit/robots.mjs",
    "./check": "./seo-toolkit/check.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test seo-toolkit/test.mjs",
    "sync:skill": "node scripts/sync-skill.mjs",
    "check:skill": "node scripts/sync-skill.mjs --check",
    "verify": "npm test && npm run check:skill",
    "prepack": "npm run sync:skill"
  }
}
